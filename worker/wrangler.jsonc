{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seeli-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "api.seeli.cam", "custom_domain": true },
    // Kept for app builds released before the move to seeli.cam.
    { "pattern": "seeli-api.tunnaduong.com", "custom_domain": true }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "vars": {
    "PUBLIC_URL": "https://api.seeli.cam",
    "REVEAL_MIN_DAYS": "27",
    "REVEAL_MAX_DAYS": "37",
    "ALLOW_DEMO": "false",
    "MAX_PHOTO_MB": "8",
    "APPLE_AUDIENCES": "com.tunnaduong.seeli",
    "APPLE_TEAM_ID": "62H5L8QDTS",
    "PUSH_RELAY_URL": "https://push.seeli.cam",
    "NEW_USER_NOTIFY_EMAIL": "tunnaduong@gmail.com",
    "NOTIFY_FROM_EMAIL": "noreply@seeli.cam"
  },
  // Secrets (wrangler secret put): JWT_SECRET, ADMIN_PASSWORD, APPLE_KEY_ID, APPLE_KEY,
  // GOOGLE_CLIENT_IDS, FCM_SERVICE_ACCOUNT, PUSH_RELAY_SECRET.
  "d1_databases": [
    { "binding": "DB", "database_name": "seeli", "database_id": "66369c06-4156-46bb-9632-146e9bde4410" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "seeli-photos" }
  ],
  // Outbound mail for the new-user alert. Only the owner's address is allowed as a recipient.
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["tunnaduong@gmail.com"] }
  ]
}
