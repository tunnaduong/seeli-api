# Copy to .env and fill in. Never commit .env.

# Long random string — generate with: openssl rand -hex 32
JWT_SECRET=

# Public URL of the API (used in photo links), e.g. https://seeli-api.example.com
PUBLIC_URL=

# Port on the server (127.0.0.1 only) that aaPanel's reverse proxy points to
HOST_PORT=8790

# "About 30 days" — random between these
REVEAL_MIN_DAYS=27
REVEAL_MAX_DAYS=37

# Allow the app's demo mode (photo returns after ~1 minute). Set false at launch.
ALLOW_DEMO=true

# Password for the admin page (https://<api-domain>/admin). deploy.sh generates one if empty.
ADMIN_PASSWORD=

# Sign in with Apple: accepted audiences (iOS bundle ID)
APPLE_AUDIENCES=com.tunnaduong.seeli
# Sign in with Apple key (developer.apple.com → Keys → Sign in with Apple). Needed to revoke
# Apple access when a user deletes their account. Put the .p8 in ./secrets (mounted read-only).
APPLE_TEAM_ID=62H5L8QDTS
APPLE_KEY_ID=
APPLE_KEY_PATH=/secrets/AuthKey.p8
# Google Sign-In: iOS OAuth client ID(s), comma separated. Empty = Google login disabled.
GOOGLE_CLIENT_IDS=

MAX_PHOTO_MB=8
LOG_LEVEL=info

# Push notifications (APNs): a .p8 key with "Apple Push Notifications service" enabled,
# placed in ./secrets (mounted read-only at /secrets). Empty APNS_KEY_ID = no pushes.
APNS_KEY_ID=
APNS_KEY_PATH=/secrets/AuthKey_APNS.p8
# Android push (FCM): Firebase service-account JSON in ./secrets. Empty = Android falls back to polling.
FCM_SERVICE_ACCOUNT_PATH=

# After the move to Cloudflare: run this server only as the APNs relay for the Worker.
RELAY_ONLY=false
# Shared secret the Worker sends in x-relay-secret (same value as the Worker's PUSH_RELAY_SECRET).
PUSH_RELAY_SECRET=
